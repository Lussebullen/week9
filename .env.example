MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=your_db_user
MONGO_PASSWORD=your_db_password
MONGO_DB=your_db_name

MONGO_EXPRESS_DEFAULT_EMAIL=your_email@example.com
MONGO_EXPRESS_DEFAULT_PASSWORD=your_pgadmin_password
MONGO_EXPRESS_PORT=8081

APP_PORT=3000